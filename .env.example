# Public Supabase client settings (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Legacy fallback only if the project still uses the old key name:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server-only Supabase settings — never prefix with NEXT_PUBLIC_
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY

# Site/admin server secrets
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_SCRYPT_HASH=REPLACE_WITH_SCRYPT_HASH
ADMIN_SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# AI integrations
GEMINI_API_KEY=REPLACE_IF_USED
GOOGLE_GENERATIVE_AI_KEY=REPLACE_IF_USED

# Email/contact integrations
RESEND_API_KEY=REPLACE_IF_USED
CONTACT_FROM_EMAIL=REPLACE_IF_USED
CONTACT_INBOX_EMAIL=REPLACE_IF_USED
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

MIGRATION_TARGET=REPLACE_IF_USED
