{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/blog",
        "http://localhost:3000/blog/quran-memorization-tools",
        "http://localhost:3000/saudi-arabia",
        "http://localhost:3000/united-arab-emirates",
        "http://localhost:3000/united-states"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox",
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 2,
          "disabled": false
        },
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
          "categories:performance": ["error", { "minScore": 0.70 }],
          "categories:accessibility": ["error", { "minScore": 0.9 }],
          "categories:best-practices": ["error", { "minScore": 0.9 }],
          "categories:seo": ["warn", { "minScore": 0.90 }],
          "metrics:first-contentful-paint": ["warn", { "maxNumericValue": 3500 }],
          "metrics:largest-contentful-paint": ["warn", { "maxNumericValue": 5000 }],
          "metrics:cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
          "metrics:total-blocking-time": ["warn", { "maxNumericValue": 350 }]
      }
    }
  }
}
